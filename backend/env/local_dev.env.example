# Local environment. Copy to local_dev.env and fill in real values.
ENV_NAME=local_dev
OPENAI_API_KEY=your-openai-api-key

DEMO_USERNAME=your-demo-username
DEMO_PASSWORD='your-demo-password'

# JWT login (hospital + ops) — see docs/mysql_scrpt.sql for the schema
JWT_SECRET=your-jwt-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=med_zen
