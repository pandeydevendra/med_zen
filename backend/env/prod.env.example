# Production environment. Copy to prod.env and fill in real values.
ENV_NAME=prod
OPENAI_API_KEY=your-openai-api-key

DEMO_USERNAME=your-demo-username
DEMO_PASSWORD='your-strong-demo-password'

# JWT login (hospital + ops) — see docs/mysql_scrpt.sql for the schema
JWT_SECRET=your-jwt-secret
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=medzen
